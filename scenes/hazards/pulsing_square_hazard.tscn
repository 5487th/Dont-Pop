[sub_resource type="GDScript" id="GDScript_pitwt"]
resource_name = "pulsing square hazard"
script/source = "extends Hazard


@export var rotation_speed:float = 15
@export var scale_change_speed:float = 0.1

@export var scale_range:Vector2 = Vector2(0.8, 1.6)

var scaling_up:bool

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	move_hazard()
	
	rotate(deg_to_rad(rotation_speed * delta))
	
	if scale.x == scale_range.x:
		scaling_up = true
	elif scale.x == scale_range.y:
		scaling_up = false
	
	if scaling_up:
		scale = scale.move_toward(Vector2(scale_range.y, scale_range.y), scale_change_speed)
	else:
		scale = scale.move_toward(Vector2(scale_range.x, scale_range.x), scale_change_speed)
		
	pass
"

