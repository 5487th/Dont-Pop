[sub_resource type="GDScript" id="GDScript_flqon"]
resource_name = "replay menu"
script/source = "extends Node2D

@export var winner_tittle_display:Label
@export var winner_balloon_display:Sprite2D
@export var transition:SceneTransition

@export var replay_button:TextureButton
@export var main_menu_button:TextureButton

@export var click_sound_effect_player:AudioStreamPlayer2D

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	transition.fade_out()
	if BalloonInfo.winner == Balloon.BalloonNumber.Balloon_1:
		winner_tittle_display.text = \"Balloon 1 wins!\"
		winner_balloon_display.modulate = Balloon.get_color(BalloonInfo.balloon_color_1)
	elif BalloonInfo.winner == Balloon.BalloonNumber.Balloon_2:
		winner_balloon_display.modulate = Balloon.get_color(BalloonInfo.balloon_color_2)
		winner_tittle_display.text = \"Balloon 2 wins!\"
	
	replay_button.pressed.connect(replay_pressed)
	main_menu_button.pressed.connect(main_menu_pressed)

func replay_pressed():
	click_sound_effect_player.play()
	transition.fade_in()
	if transition.animation_player.is_playing():
		await transition.animation_player.animation_finished
	SceneManager.change_to_main_game_scene()

func main_menu_pressed():
	click_sound_effect_player.play()
	transition.fade_in()
	if transition.animation_player.is_playing():
		await transition.animation_player.animation_finished
	SceneManager.change_to_main_menu_scene()
"

